# release 签名配置模板（本文件会提交，不含真实密码）
# 使用 release 签名需先：
#   1. 生成密钥库（keytool）：
#        keytool -genkeypair -v -keystore app/keystore/release.keystore \
#          -alias lifehelper -keyalg RSA -keysize 2048 -validity 10000
#   2. 复制本文件为 keystore.properties 并填入真实密码
KEYSTORE_PATH=app/keystore/release.keystore
KEYSTORE_PASSWORD=你的密钥库密码
KEY_ALIAS=lifehelper
KEY_PASSWORD=你的密钥密码
